      <font>
       <pointsize>16</pointsize>
       <bold>true</bold>
      </font>
     </property>
     <property name="text">
      <string>客房管理</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="gridLayout_form">
     <item row="0" column="0">
      <widget class="QLabel" name="label_roomnum">
       <property name="text">
        <string>房间号：</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="lineEdit_roomnum">
       <property name="placeholderText">
        <string>如：101、202</string>
       </property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="QLabel" name="label_type">
       <property name="text">
        <string>房间类型：</string>
       </property>
      </widget>
     </item>
     <item row="0" column="3">
      <widget class="QLineEdit" name="lineEdit_type">
       <property name="placeholderText">
        <string>如：单人间、双人间、套房</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="label_price">
       <property name="text">
